def add_setting(settings, new_setting):
    key, value = new_setting
    key = key.lower()
    value = value.lower()
    if key in settings :
        return f'Setting \'{key}\' already exists! Cannot add a new setting with this name.'
    else:
        settings[key] = value
        return f"Setting \'{key}\' added with value \'{value}\' successfully!"

def update_setting(param, tupl):
    key, value = tupl
    key = key.lower()
    value = value.lower()
    if key in param :
        param[key] = value
        return f"Setting \'{key}\' updated to \'{value}\' successfully!"
    else:
        return f"Setting \'{key}\' does not exist! Cannot update a non-existing setting."

def delete_setting(params, cle):
    cle = cle.lower()
    if cle in params :
       del params[cle]
       return f"Setting '{cle}' deleted successfully!"
    else :
       return "Setting not found!"

def view_settings(dict_param):
    if len(dict_param) == 0:
        return "No settings available."
    else:
        result = f"Current User Settings:\n"
        for key, value in dict_param.items():     
            result += f"{key.capitalize()}: {value}\n" 
        return result
test_settings = {
    'theme' : 'dark',
    'language' : 'french',
    'notifications' : 'enabled'
}
        
print(add_setting(test_settings, ('VOLUME', 'HIGH')))
print(update_setting(test_settings, ('THEME', 'LIGHT')))
print(delete_setting(test_settings, 'LANGUAGE'))
print(view_settings(test_settings))
        


    